# Caddyfile — proxy reverso com HTTPS automático (Let's Encrypt).
# Aponte o A record do DOMAIN para o IP público do servidor antes de subir.

{
    auto_https off
    certificates {
        load_files /etc/caddy/certs/autoshopping.crt /etc/caddy/certs/autoshopping.key
    }
}

:443 {
    tls internal {
        on_demand off
    }

    @sse {
        path /api/events
    }
    reverse_proxy @sse app:4173 {
        flush_interval -1
        transport http {
            read_timeout 24h
        }
    }

    reverse_proxy /webhooks/* app:4173
    reverse_proxy /* app:4173

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format console
    }
}

:80 {
    redir https://{host}{uri} permanent
}