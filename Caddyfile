{
    auto_https disable_certs
}

autoshoppingformula.com.br {
    encode zstd gzip

    tls /etc/caddy/certs/autoshopping.crt /etc/caddy/certs/autoshopping.key

    @sse {
        path /api/events
    }
    reverse_proxy @sse app:4173 {
        flush_interval -1
        transport http {
            read_timeout 24h
        }
    }

    reverse_proxy /webhooks/* app:4173
    reverse_proxy /* app:4173

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format console
    }
}