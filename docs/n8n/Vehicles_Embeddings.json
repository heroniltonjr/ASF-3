    {
      "parameters": {
        "jsCode": "const rows = $(\"Buscar veículos sem embedding\").all();\nconst data = $input.first().json.data || [];\nreturn data.map(d => ({ json: { identifier: rows[d.index].json.identifier, embedding: \"[\" + d.embedding.join(\",\") + \"]\" } }));"
      },
      "id": "6f895f1b-742f-499c-bd1e-49d51e20a21a",
      "name": "Parear embedding com veículo",
      "type": "n8n-nodes-base.code",
